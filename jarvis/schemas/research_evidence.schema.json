{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zentra.local/schemas/research-evidence-v1.json",
  "title": "Jarvis ResearchEvidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id", "claim", "label", "sources",
    "based_on_evidence_ids", "uncertainty_reason"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "claim": {"type": "string", "minLength": 1, "maxLength": 4000},
    "label": {"enum": ["FACT", "INFERENCE", "ASSUMPTION", "INTENT"]},
    "sources": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "locator", "observed_at", "commit_sha", "excerpt_sha256"],
        "properties": {
          "kind": {
            "enum": [
              "repository_file", "git_commit", "test_output", "mission_record",
              "human_statement", "product_document", "external_document",
              "web_source", "metric"
            ]
          },
          "locator": {"type": "string", "minLength": 1, "maxLength": 2000},
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "description": "A real UTC calendar timestamp at whole-second precision, exactly YYYY-MM-DDTHH:MM:SSZ; enforced explicitly by jarvis/evidence.py."
          },
          "commit_sha": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            ]
          },
          "excerpt_sha256": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            ]
          }
        }
      }
    },
    "based_on_evidence_ids": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
    },
    "uncertainty_reason": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 2000}
      ]
    }
  }
}
