{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["schema_version","repositories"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "repositories":{"type":"array","minItems":1,"maxItems":4,"items":{
      "type":"object","additionalProperties":false,
      "required":["key","host","owner","name","authorized_ref","authorized_commit_sha","sources"],
      "properties":{
        "key":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,31}$"},
        "host":{"const":"github.com"},
        "owner":{"type":"string","pattern":"^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"},
        "name":{"type":"string","pattern":"^[A-Za-z0-9._-]{1,100}$"},
        "authorized_ref":{"type":"string","pattern":"^refs/(heads|remotes/origin)/[A-Za-z0-9](?:[A-Za-z0-9._/-]{0,120}[A-Za-z0-9_-])?$"},
        "authorized_commit_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
        "sources":{
      "type":"array","minItems":1,"maxItems":12,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["path","tier","kind"],
        "properties":{
          "path":{
            "type":"string","minLength":1,"maxLength":300,
            "pattern":"^(?!.*\\.\\.)(?!.*//)(?!/)(?!.*/$)[A-Za-z0-9_.\\-][A-Za-z0-9_.\\-/]*$"
          },
          "tier":{"enum":["canonical","complementary"]},
          "kind":{"enum":["repository_file","product_document"]}
        }
      }}
      }
    }}
  }
}
