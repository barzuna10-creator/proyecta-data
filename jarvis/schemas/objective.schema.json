{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zentra.local/schemas/objective-v1.json",
  "title": "Jarvis Objective V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "objective_id", "revision", "created_at", "updated_at",
    "raw_intent", "priority", "status", "decomposition"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "objective_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "raw_intent": {"type": "string", "minLength": 1, "maxLength": 10000},
    "priority": {"enum": ["unset", "low", "normal", "high"]},
    "status": {"enum": ["proposed", "decomposed", "closed"]},
    "decomposition": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "draft_id", "title", "rationale", "outcome", "scope",
          "non_goals", "acceptance_criteria", "open_questions"
        ],
        "properties": {
          "draft_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
          "outcome": {"type": "string", "minLength": 1, "maxLength": 4000},
          "scope": {"$ref": "#/$defs/string_set"},
          "non_goals": {"$ref": "#/$defs/optional_string_set"},
          "acceptance_criteria": {"$ref": "#/$defs/string_set"},
          "open_questions": {"$ref": "#/$defs/optional_string_set"}
        }
      }
    }
  },
  "$defs": {
    "string_set": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "optional_string_set": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "proposed"}}}, "then": {
        "properties": {"decomposition": {"maxItems": 0}}
      }
    },
    {
      "if": {"properties": {"status": {"const": "decomposed"}}}, "then": {
        "properties": {"decomposition": {"minItems": 2, "maxItems": 4}}
      }
    }
  ]
}
