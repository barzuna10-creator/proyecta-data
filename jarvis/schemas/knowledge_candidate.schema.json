{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["schema_version","candidate_id","revision","created_at","target_knowledge_id","expected_target_revision","expected_current_status","proposed_entry_status","claim","label","applicability","repository_binding","research_evidence","based_on","contradicts","supersedes","uncertainty_reason"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "candidate_id":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "revision":{"type":"integer","minimum":1},"created_at":{"type":"string"},
    "target_knowledge_id":{"type":["string","null"]},"expected_target_revision":{"type":["integer","null"],"minimum":1},
    "expected_current_status":{"enum":[null,"active","stale","conflicted","superseded","retired"]},
    "proposed_entry_status":{"enum":["active","stale","conflicted","superseded","retired"]},
    "claim":{"type":"string","minLength":1,"maxLength":4000},
    "label":{"enum":["FACT","INFERENCE","ASSUMPTION","INTENT"]},
    "applicability":{"type":"object","additionalProperties":false,"required":["product_areas","limitations"],"properties":{"product_areas":{"type":"array","minItems":1,"maxItems":50,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":200}},"limitations":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":1000}}}},
    "repository_binding":{"type":["object","null"]},"research_evidence":{"type":"array","minItems":1,"maxItems":50},
    "based_on":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"type":"string"}},
    "contradicts":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"type":"string"}},
    "supersedes":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"type":"string"}},
    "uncertainty_reason":{"type":["string","null"]}
  }
}
