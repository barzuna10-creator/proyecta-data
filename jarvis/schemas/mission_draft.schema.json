{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zentra.local/schemas/mission-draft-v1.json",
  "title": "Jarvis MissionDraft V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "draft_id", "revision", "created_at", "updated_at",
    "raw_intent", "mission_definition", "research_evidence", "risks",
    "open_questions", "repository_context"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "draft_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "raw_intent": {"type": "string", "minLength": 1, "maxLength": 10000},
    "mission_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "scope", "non_goals", "acceptance_criteria"],
      "properties": {
        "outcome": {"type": "string", "minLength": 1, "maxLength": 4000},
        "scope": {"$ref": "#/$defs/string_set"},
        "non_goals": {"$ref": "#/$defs/optional_string_set"},
        "acceptance_criteria": {"$ref": "#/$defs/string_set"}
      }
    },
    "research_evidence": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "research_evidence.schema.json"}
    },
    "risks": {"$ref": "#/$defs/optional_string_set"},
    "open_questions": {"$ref": "#/$defs/optional_string_set"},
    "repository_context": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["remote_ref", "expected_base_sha"],
          "properties": {
            "remote_ref": {"type": "string", "minLength": 1, "maxLength": 500},
            "expected_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        }
      ]
    }
  },
  "$defs": {
    "string_set": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "optional_string_set": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    }
  }
}
